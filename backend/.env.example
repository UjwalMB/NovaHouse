# ==============================================================================
# NOVA HOUSE · Backend Environment Configuration Template
# Place real production values ONLY in your Render environment or local backend/.env
# NEVER commit real passwords or secret keys to Git.
# ==============================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Database Configuration (Supabase PostgreSQL / SQLite fallback)
DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres

# Razorpay Payment Gateway Credentials (TEST MODE)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_MODE=TEST

# JWT Secret Key for HMAC-SHA256 Token Signing
JWT_SECRET_KEY=your_secure_jwt_secret_key_here

# Staff Credential Overrides (Optional: configure secure passwords on Render)
ADMIN_PASSWORD=your_secure_admin_password_here
MANAGER_PASSWORD=your_secure_manager_password_here
ANALYST_PASSWORD=your_secure_analyst_password_here

# Security & CORS Whitelist (Comma-separated exact origins, NO wildcards)
ALLOWED_ORIGINS=https://nova-house-hotel.vercel.app,https://nova-house-admin.vercel.app,https://nova-house-dashboard.vercel.app,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
